      "name": "Primary Gradient",
      "description": "Main brand gradient from indigo to purple",
      "css": "linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%)",
      "stops": [
        { "color": "#4f46e5", "position": "0%" },
        { "color": "#7c3aed", "position": "100%" }
      ]
    },
    "login": {
      "name": "Login Background",
      "description": "Three-color gradient for login pages",
      "css": "linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #ec4899 100%)",
      "stops": [
        { "color": "#4f46e5", "position": "0%" },
