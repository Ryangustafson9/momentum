# ==================== MOMENTUM GYM MANAGEMENT APP ====================
# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ==================== SUPABASE CONFIGURATION ====================
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ==================== STRIPE CONFIGURATION ====================
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# ==================== APP CONFIGURATION ====================
VITE_APP_NAME=Momentum Gym Management
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development

# ==================== FEATURE FLAGS ====================
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_REAL_TIME=true
VITE_ENABLE_DEBUG_MODE=true

# ==================== LOGGING CONFIGURATION ====================
VITE_LOG_LEVEL=DEBUG
VITE_ENABLE_CONSOLE_LOGGING=true
VITE_ENABLE_EXTERNAL_LOGGING=false

# ==================== SENTRY CONFIGURATION (Optional) ====================
# VITE_SENTRY_DSN=your_sentry_dsn
# VITE_SENTRY_ENVIRONMENT=development

# ==================== API CONFIGURATION ====================
VITE_API_TIMEOUT=30000
VITE_MAX_RETRIES=3

# ==================== SESSION CONFIGURATION ====================
VITE_SESSION_TIMEOUT=1800000
VITE_AUTO_LOGOUT_WARNING=300000

# ==================== FILE UPLOAD CONFIGURATION ====================
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ==================== DEVELOPMENT CONFIGURATION ====================
# Only used in development mode
VITE_DEV_MOCK_DATA=false
VITE_DEV_SKIP_AUTH=false
VITE_DEV_SHOW_QUERIES=false
